# Producción: el frontend se sirve desde el mismo dominio que la API.
# nginx/reverse proxy enruta /api a la API (.NET). VITE_API_URL=/api se
# convierte en "" (mismo origen), y los servicios siguen usando rutas /api/...
VITE_API_URL=/api

# Google AdSense (anuncios en páginas públicas). El ID de publicador NO es un
# secreto: AdSense exige que viaje embebido en el bundle.
VITE_ADSENSE_CLIENT=ca-pub-7789207730134520
VITE_ADSENSE_ENABLED=true
# --- Desarrollo (vite dev, puerto 5173) ------------------------------
# La API corre localmente en el puerto 8080.
VITE_API_URL=http://localhost:8080

# --- Producción (vite build) ------------------------------------------
# El frontend se sirve desde el mismo dominio que la API; nginx/reverse
# proxy enruta /api hacia la API (.NET). Se define en Frontend/.env.production
# (VITE_API_URL=/api). No repetir aquí: el valor de .env.production gana en
# `npm run build`.

# --- Publicidad (Google AdSense) --------------------------------------
# El ID de publicador no es un secreto (AdSense exige que viaje embebido en
# el bundle). Mantener VITE_ADSENSE_ENABLED=false en desarrollo: Google
# penaliza el "tráfico inválido" (localhost/dev). El valor real se define en
# Frontend/.env.production.
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXX
VITE_ADSENSE_ENABLED=false
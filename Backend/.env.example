# ==========================================
# AutoMarketRD - Variables de Entorno (Ejemplo)
# ==========================================
# COPIAR este archivo a .env.dev o .env.prod
# NUNCA commitear .env.dev o .env.prod al repo

# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-aqui
POSTGRES_DB=AutoMarketDB
POSTGRES_PORT=5432

# Connection string para .NET
# Dev: Host=localhost;Database=AutoMarketDB;Username=postgres;Password=xxx
# Prod: Host=db;Database=AutoMarketDB;Username=postgres;Password=xxx
ConnectionStrings__DefaultConnection=Host=localhost;Database=AutoMarketDB;Username=postgres;Password=tu-password-aqui

# ==========================================
# ADMIN INICIAL (creado por el Seeder)
# ==========================================
# Estas credenciales NUNCA deben quedar hardcodeadas en el código.
# Si se dejan vacías, el seeder NO crea el usuario admin.
AdminEmail=admin@automarket.do
AdminPassword=cambia-esta-contrasena-fuerte
# Poner AdminRotatePassword=true para reemplazar la contraseña de un admin ya existente (rotación).
AdminRotatePassword=false

# ==========================================
# URL PÚBLICA DEL FRONTEND (enlaces en correos, ej: confirmar correo)
# ==========================================
# Dev: http://localhost:5173 (Vite). Prod: https://tu-dominio.com
APP_FRONTEND_URL=http://localhost:5173

# ==========================================
# JWT
# ==========================================
JwtSecret=tu-secreto-muy-largo-y-seguro-aqui-minimo-32-caracteres
JwtIssuer=AutoMarket
JwtAudience=AutoMarketUsers

# ==========================================
# CORS
# ==========================================
# Dev: http://localhost:5173 (Vite)
# Prod: https://tudominio.com
CorsAllowedOrigins=http://localhost:5173

# ==========================================
# EMAIL (SMTP)
# ==========================================
SmtpHost=smtp.gmail.com
SmtpPort=587
SmtpUser=tu-email@gmail.com
SmtpPass=tu-app-password
SmtpFromName=AutoMarket RD
SmtpFromEmail=tu-email@gmail.com

# ==========================================
# PAYPAL
# ==========================================
PayPalClientId=tu-client-id
PayPalClientSecret=tu-client-secret
PayPalApiUrl=https://api-m.sandbox.paypal.com

# ==========================================
# PAGO (Conversión RD$ -> USD para PayPal)
# ==========================================
# Cuántos dólares equivale 1 peso dominicano (RD$ * tasa = USD).
# Ejemplo: 1 RD$ ≈ 0.017 USD  (tasa de cambio RD$ a USD).
Pago__TasaCambioRD_USD=0.017

# ==========================================
# AWS S3 (Opcional)
# ==========================================
AwsAccessKeyId=tu-access-key
AwsSecretAccessKey=tu-secret-key
AwsRegion=us-east-1
S3BucketName=tu-bucket-name

# ==========================================
# SERVICIOS EXTERNOS (Opcional)
# ==========================================
# OpticoDdds, etc.
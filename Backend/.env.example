# ==========================================
# AutoMarketRD - Variables de Entorno (Ejemplo)
# ==========================================
# COPIAR este archivo a .env.dev, .env.staging o .env.prod
# NUNCA commitear .env.dev, .env.staging ni .env.prod al repo.
# Los nombres de variable coinciden con los docker-compose.*.yml.

# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-aqui
POSTGRES_DB=AutoMarketDB
POSTGRES_PORT=5432

# Connection string para .NET
# Dev: Host=localhost;Database=AutoMarketDB;Username=postgres;Password=xxx
# Prod: Host=db;Database=AutoMarketDB;Username=postgres;Password=xxx
CONNECTION_STRING=Host=localhost;Database=AutoMarketDB;Username=postgres;Password=tu-password-aqui

# ==========================================
# ADMIN INICIAL (creado por el Seeder)
# ==========================================
# Estas credenciales NUNCA deben quedar hardcodeadas en el código.
# Si se dejan vacías, el seeder NO crea el usuario admin.
# Prod usa ADMIN_EMAIL_PROD / ADMIN_PASSWORD_PROD (ver docker-compose.prod.yml).
ADMIN_EMAIL=admin@automarket.do
ADMIN_PASSWORD=cambia-esta-contrasena-fuerte
# Poner ADMIN_ROTATE_PASSWORD=true para reemplazar la contraseña de un admin ya existente (rotación).
ADMIN_ROTATE_PASSWORD=false

# ==========================================
# URL PÚBLICA DEL FRONTEND (enlaces en correos, ej: confirmar correo)
# ==========================================
# Dev: http://localhost:5173 (Vite). Prod: https://tudominio.com
APP_FRONTEND_URL=http://localhost:5173

# ==========================================
# JWT
# ==========================================
JWT_SECRET=tu-secreto-muy-largo-y-seguro-aqui-minimo-32-caracteres
JWT_ISSUER=AutoMarket
JWT_AUDIENCE=AutoMarketUsers

# ==========================================
# CORS
# ==========================================
# Dev: http://localhost:5173 (Vite)
# Prod: https://tudominio.com,https://www.tudominio.com (CORS_ALLOWED_ORIGINS_PROD)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_SENDER_NAME=AutoMarket RD
SMTP_SENDER_EMAIL=tu-email@gmail.com

# ==========================================
# PAYPAL
# ==========================================
# Dev/Staging: PAYPAL_MODE=Sandbox, PAYPAL_URL_BASE=https://api-m.sandbox.paypal.com
# Producción:  PAYPAL_MODE=Live, PAYPAL_URL_BASE=https://api-m.paypal.com
PAYPAL_MODE=Sandbox
PAYPAL_URL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_CLIENT_SECRET=tu-client-secret
PAYPAL_RETURN_URL=http://localhost:5173/pago-exitoso
PAYPAL_CANCEL_URL=http://localhost:5173/pago-cancelado
PAYPAL_WEBHOOK_ID=

# ==========================================
# PAGO (Conversión RD$ -> USD para PayPal)
# ==========================================
# Cuántos dólares equivale 1 peso dominicano (RD$ * tasa = USD).
# Ejemplo: 1 RD$ ≈ 0.017 USD  (tasa de cambio RD$ a USD).
PAGO_TASA_CAMBIO_RD_USD=0.017

# ==========================================
# ALMACENAMIENTO DE IMÁGENES (AWS S3 o Cloudflare R2)
# ==========================================
AWS_ACCESS_KEY=tu-access-key
AWS_SECRET_KEY=tu-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=tu-bucket-name
# Cloudflare R2: AWS_SERVICE_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS S3 real:   deja AWS_SERVICE_URL vacío (usa RegionEndpoint automáticamente).
AWS_SERVICE_URL=
# Vigencia en minutos de las URLs firmadas (default 15).
AWS_EXPIRATION_MINUTES=15

# ==========================================
# MIGRACIONES Y SEEDER
# ==========================================
# En prod se recomienda ejecutar `dotnet ef database update` como paso del
# deploy (MIGRATE_ON_STARTUP=false). El seeder crea el admin inicial y los
# planes; actívalo UNA vez en el primer arranque y luego vuelve a false.
MIGRATE_ON_STARTUP=false
SEEDER_ENABLED=false
# ==========================================
# AutoMarketRD - Staging Environment (Ejemplo)
# ==========================================
# COPIAR este archivo a .env.staging:
#   cp .env.staging.example .env.staging
# NUNCA commitear .env.staging al repo (esta en .gitignore).
#
# El docker-compose.staging.yml usa estos valores. Las claves de PayPal
# son OBLIGATORIAS: si faltan, el compose fallara al levantar el API
# (intencional, para evitar errores 500 silenciosos como el de
# /api/pagos/generar-link con credenciales placeholder).

# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_DB=automarket_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=automarketpass-staging

# Tuning de Postgres (mismos defaults que prod, dimensionados para droplet 2 GB).
# Si el servidor de staging es distinto, ajusta aqui sin tocar el compose.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAX_CONNECTIONS=60
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB

# Connection string para .NET (debe coincidir con POSTGRES_* de arriba)
# Host=db es el nombre del servicio en docker-compose
# "Maximum Pool Size" limita el pool de Npgsql (default 100) para no
# agotar PG_MAX_CONNECTIONS (deja margen para pg_dump y migraciones).
CONNECTION_STRING=Host=db;Port=5432;Database=automarket_staging;Username=staging_user;Password=automarketpass-staging;Maximum Pool Size=40

# ==========================================
# JWT
# ==========================================
JWT_SECRET=staging-jwt-secret-key-muy-largo-y-seguro-minimo-32-chars
JWT_ISSUER=StagingAPI
JWT_AUDIENCE=StagingClient

# ==========================================
# SMTP
# ==========================================
SMTP_HOST=smtp.staging.example.com
SMTP_PORT=587
SMTP_USER=staging@automarketrd.com
SMTP_PASSWORD=cambia-este-app-password
SMTP_SENDER_NAME=AutoMarket RD Staging
# Email remitente (Brevo exige que coincida con un remitente validado)
SMTP_SENDER_EMAIL=no-reply@staging.automarketrd.com

# ==========================================
# AWS S3
# ==========================================
AWS_ACCESS_KEY=tu-access-key-staging
AWS_SECRET_KEY=tu-secret-key-staging
AWS_REGION=us-east-2
AWS_BUCKET_NAME=automarketrd-s3-staging
# Endpoint S3-compatible (obligatorio para R2 de Cloudflare):
#   https://<ID_CUENTA>.r2.cloudflarestorage.com
# Para AWS S3 real, dejar vacio.
AWS_SERVICE_URL=https://tu-id-cuenta.r2.cloudflarestorage.com

# ==========================================
# PAYPAL (OBLIGATORIO)
# ==========================================
# Credenciales Sandbox reales obtenidas en:
#   https://developer.paypal.com/dashboard/applications/sandbox
# Usar las credenciales de la pestaña "Live" en produccion, no aqui.
PAYPAL_MODE=Sandbox
PAYPAL_URL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=tu-client-id-sandbox-real
PAYPAL_CLIENT_SECRET=tu-client-secret-sandbox-real

# URL publica del frontend de staging (debe ser alcanzable desde el navegador
# del comprador). En local con docker-compose seria http://localhost:5174/...
# En un servidor de staging, algo como https://staging.tudominio.com/...
PAYPAL_RETURN_URL=http://localhost:5174/pago-exitoso
PAYPAL_CANCEL_URL=http://localhost:5174/pago-cancelado

# Webhook ID configurado en PayPal para verificar la firma del webhook.
# Si se deja vacio, el endpoint /api/pagos/webhook devolvera Unauthorized.
PAYPAL_WEBHOOK_ID=

# ==========================================
# PAGO (Conversion RD$ -> USD para PayPal)
# ==========================================
# Cuantos USD equivale 1 peso dominicano (RD$ * tasa = USD).
# Ejemplo: 1 RD$ ~= 0.017 USD.
# (Esta variable se inyecta en Pago__TasaCambioRD_USD; para cambiarla
# en staging, agregarla al docker-compose.staging.yml o appsettings.)
# Pago__TasaCambioRD_USD=0.017

# ==========================================
# CORS (origenes permitidos para el frontend)
# ==========================================
CORS_ALLOWED_ORIGIN_0=http://localhost:5173
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=http://localhost:5174

# ==========================================
# MIGRACIONES Y SEEDER
# ==========================================
MIGRATE_ON_STARTUP=true
SEEDER_ENABLED=true

# ==========================================
# ADMIN INICIAL (creado por el Seeder)
# ==========================================
# Si se dejan vacios, el seeder NO crea el usuario admin.
ADMIN_EMAIL=admin@staging.automarketrd.com
ADMIN_PASSWORD=cambia-esta-contrasena-staging-fuerte
ADMIN_ROTATE_PASSWORD=false

# ==========================================
# URL PÚBLICA DEL FRONTEND (enlaces en correos, ej: confirmar correo)
# ==========================================
APP_FRONTEND_URL=http://localhost:5174
